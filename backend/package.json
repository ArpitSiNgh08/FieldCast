{
  "name": "fieldcast-backend",
  "version": "1.0.0",
  "description": "FieldCast backend — Express + Socket.io + PostgreSQL live sports streaming API",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "prestart": "prisma generate",
    "start": "node src/index.js",
    "predev": "prisma generate",
    "dev": "nodemon src/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
