// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Connection URL is configured in prisma.config.ts (Prisma 7 requirement).
  // Set DATABASE_URL in .env — it's picked up by prisma.config.ts automatically.
}

// ─── Auth ─────────────────────────────────────────────────────────────────

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String?
  avatarUrl    String?  @map("avatar_url")
  passwordHash String?  @map("password_hash")
  // 'viewer' | 'admin'
  role         String   @default("viewer")
  createdAt    DateTime @default(now()) @map("created_at")

  tournamentsCreated       Tournament[]          @relation("TournamentCreator")
  tournamentsReviewed      Tournament[]          @relation("TournamentReviewer")
  tournamentOrganiserRoles TournamentOrganizer[]
  teamsCreated             Team[]
  playersCreated           Player[]

  @@map("users")
}

// ─── Core (sport-agnostic) ────────────────────────────────────────────────

model Team {
  id        Int      @id @default(autoincrement())
  name      String
  shortName String   @map("short_name")
  logoUrl   String?  @map("logo_url")
  // 'cricket' | 'football' | 'basketball'
  sport     String
  ownerId   Int?     @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")

  matchesAsA        Match[]            @relation("TeamA")
  matchesAsB        Match[]            @relation("TeamB")
  wonMatches        Match[]            @relation("Winner")
  standings         Standing[]
  standingOverrides StandingOverride[]
  cricketEvents     CricketEvent[]
  footballEvents    FootballEvent[]
  owner             User?              @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  tournaments       TournamentTeam[]
  players           TeamPlayer[]

  @@map("teams")
}

model Tournament {
  id              Int       @id @default(autoincrement())
  name            String
  // 'cricket' | 'football' | 'basketball'
  sport           String
  // 'league' | 'knockout' | free text
  format          String?
  startDate       DateTime? @map("start_date") @db.Date
  endDate         DateTime? @map("end_date") @db.Date
  // 'upcoming' | 'ongoing' | 'completed'
  status          String    @default("upcoming")
  imageUrl        String?   @map("image_url") @db.Text
  // 'draft' | 'submitted' | 'approved' | 'rejected'
  approvalStatus  String    @default("draft") @map("approval_status")
  rejectionReason String?   @map("rejection_reason")
  creatorId       Int?      @map("creator_id")
  reviewedById    Int?      @map("reviewed_by_id")
  submittedAt     DateTime? @map("submitted_at")
  reviewedAt      DateTime? @map("reviewed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  matches           Match[]
  standings         Standing[]
  standingOverrides StandingOverride[]
  creator           User?                 @relation("TournamentCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  reviewedBy        User?                 @relation("TournamentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  teams             TournamentTeam[]
  pools             TournamentPool[]
  organizers        TournamentOrganizer[]

  @@index([approvalStatus])
  @@index([creatorId])
  @@map("tournaments")
}

model TournamentPool {
  id           Int      @id @default(autoincrement())
  tournamentId Int      @map("tournament_id")
  name         String
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")

  tournament Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teams      TournamentTeam[]
  matches    Match[]

  @@unique([tournamentId, name])
  @@index([tournamentId, sortOrder])
  @@map("tournament_pools")
}

model TournamentOrganizer {
  tournamentId Int      @map("tournament_id")
  userId       Int      @map("user_id")
  addedById    Int?     @map("added_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tournamentId, userId])
  @@index([userId])
  @@map("tournament_organizers")
}

model TournamentTeam {
  tournamentId Int      @map("tournament_id")
  teamId       Int      @map("team_id")
  poolId       Int?     @map("pool_id")
  seed         Int?
  createdAt    DateTime @default(now()) @map("created_at")

  tournament Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team       Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  pool       TournamentPool? @relation(fields: [poolId], references: [id], onDelete: SetNull)

  @@id([tournamentId, teamId])
  @@index([poolId])
  @@map("tournament_teams")
}

model Player {
  id        Int      @id @default(autoincrement())
  name      String
  ownerId   Int?     @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  owner            User?           @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  teams            TeamPlayer[]
  footballEvents   FootballEvent[]
  substitutionsOut FootballEvent[] @relation("FootballSubOut")
  substitutionsIn  FootballEvent[] @relation("FootballSubIn")

  @@index([ownerId])
  @@map("players")
}

model TeamPlayer {
  teamId       Int      @map("team_id")
  playerId     Int      @map("player_id")
  jerseyNumber String   @map("jersey_number")
  position     String?
  // 'playing' | 'bench'
  squadRole    String   @default("bench") @map("squad_role")
  createdAt    DateTime @default(now()) @map("created_at")

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([teamId, playerId])
  @@unique([teamId, jerseyNumber])
  @@map("team_players")
}

model Match {
  id                 Int       @id @default(autoincrement())
  tournamentId       Int?      @map("tournament_id")
  // 'pool' | 'knockout'; null only for legacy fixtures
  stageType          String?   @map("stage_type")
  poolId             Int?      @map("pool_id")
  knockoutStage      String?   @map("knockout_stage")
  teamAId            Int       @map("team_a_id")
  teamBId            Int       @map("team_b_id")
  // 'cricket' | 'football' | 'basketball'
  sport              String
  scheduledAt        DateTime? @map("scheduled_at")
  // 'upcoming' | 'live' | 'completed'
  status             String    @default("upcoming")
  winnerTeamId       Int?      @map("winner_team_id")
  // 'pending' | 'played' | 'washout'
  resultType         String    @default("pending") @map("result_type")
  // 'camera1' | 'camera2' | 'camera3'
  activeCamera       String    @default("camera1") @map("active_camera")
  // Optional explicit stream override; null → frontend derives from SRS_HLS_BASE
  streamUrl          String?   @map("stream_url")
  // ImageKit / HLS VOD URL when completed
  replayUrl          String?   @map("replay_url")
  venue              String?
  broadcastChecklist Json      @default("{}") @map("broadcast_checklist")
  createdAt          DateTime  @default(now()) @map("created_at")

  tournament         Tournament?         @relation(fields: [tournamentId], references: [id])
  pool               TournamentPool?     @relation(fields: [poolId], references: [id], onDelete: SetNull)
  teamA              Team                @relation("TeamA", fields: [teamAId], references: [id])
  teamB              Team                @relation("TeamB", fields: [teamBId], references: [id])
  winner             Team?               @relation("Winner", fields: [winnerTeamId], references: [id])
  state              MatchState?
  cricketEvents      CricketEvent[]
  footballEvents     FootballEvent[]
  basketballQuarters BasketballQuarter[]
  cameras            MatchCamera[]

  @@index([tournamentId])
  @@index([poolId])
  @@index([status])
  @@map("matches")
}

model MatchCamera {
  id        Int      @id @default(autoincrement())
  matchId   Int      @map("match_id")
  name      String
  angle     String
  streamKey String   @unique @map("stream_key")
  createdAt DateTime @default(now()) @map("created_at")

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
  @@map("match_cameras")
}

model Standing {
  id            Int @id @default(autoincrement())
  tournamentId  Int @map("tournament_id")
  teamId        Int @map("team_id")
  played        Int @default(0)
  won           Int @default(0)
  lost          Int @default(0)
  drawn         Int @default(0)
  points        Int @default(0)
  // Goals / runs / points scored (tie-breaker, sport-dependent)
  scoredFor     Int @default(0) @map("scored_for")
  scoredAgainst Int @default(0) @map("scored_against")

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team       Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, teamId])
  @@map("standings")
}

model StandingOverride {
  id            Int      @id @default(autoincrement())
  tournamentId  Int      @map("tournament_id")
  teamId        Int      @map("team_id")
  played        Int?
  won           Int?
  lost          Int?
  drawn         Int?
  points        Int?
  scoredFor     Int?     @map("scored_for")
  scoredAgainst Int?     @map("scored_against")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team       Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, teamId])
  @@map("standing_overrides")
}

// ─── Live overlay state (one row per match) ───────────────────────────────

model MatchState {
  id          Int      @id @default(autoincrement())
  matchId     Int      @unique @map("match_id")
  // runs / goals / total points
  teamAScore  Int      @default(0) @map("team_a_score")
  teamBScore  Int      @default(0) @map("team_b_score")
  // over / half / quarter number
  period      Int      @default(1)
  // "Over 18.4" / "Half 2" / "Q3 8:24"
  periodLabel String   @default("") @map("period_label")
  // 'live' | 'break' | 'completed'
  status      String   @default("break")
  // Sport-specific quick fields (wickets, minute, clock…)
  extra       Json     @default("{}")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@map("match_state")
}

// ─── Sport-specific event tables (detailed scorecards + history) ──────────

model CricketEvent {
  id            Int      @id @default(autoincrement())
  matchId       Int      @map("match_id")
  innings       Int      @default(1)
  // e.g. 18.4 (18 overs + 4 balls)
  overNumber    Decimal  @default(0) @map("over_number") @db.Decimal(5, 1)
  battingTeamId Int?     @map("batting_team_id")
  runsTotal     Int      @default(0) @map("runs_total")
  wickets       Int      @default(0)
  runRate       Decimal  @default(0) @map("run_rate") @db.Decimal(5, 2)
  extras        Int      @default(0)
  description   String?
  createdAt     DateTime @default(now()) @map("created_at")

  match       Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  battingTeam Team? @relation(fields: [battingTeamId], references: [id])

  @@index([matchId])
  @@map("cricket_events")
}

model FootballEvent {
  id              Int      @id @default(autoincrement())
  matchId         Int      @map("match_id")
  half            Int      @default(1)
  minute          Int      @default(0)
  extraTimeMinute Int      @default(0) @map("extra_time_minute")
  // 'goal' | 'yellow_card' | 'red_card' | 'substitution'
  eventType       String   @map("event_type")
  teamId          Int?     @map("team_id")
  playerId        Int?     @map("player_id")
  playerName      String?  @map("player_name")
  jerseyNumber    String?  @map("jersey_number")
  playerOutId     Int?     @map("player_out_id")
  playerOutName   String?  @map("player_out_name")
  playerOutJersey String?  @map("player_out_jersey")
  playerInId      Int?     @map("player_in_id")
  playerInName    String?  @map("player_in_name")
  playerInJersey  String?  @map("player_in_jersey")
  createdAt       DateTime @default(now()) @map("created_at")

  match     Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team      Team?   @relation(fields: [teamId], references: [id])
  player    Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)
  playerOut Player? @relation("FootballSubOut", fields: [playerOutId], references: [id], onDelete: SetNull)
  playerIn  Player? @relation("FootballSubIn", fields: [playerInId], references: [id], onDelete: SetNull)

  @@index([matchId])
  @@index([playerId])
  @@index([playerOutId])
  @@index([playerInId])
  @@map("football_events")
}

model BasketballQuarter {
  id            Int      @id @default(autoincrement())
  matchId       Int      @map("match_id")
  quarter       Int      @default(1)
  teamAPoints   Int      @default(0) @map("team_a_points")
  teamBPoints   Int      @default(0) @map("team_b_points")
  teamAFouls    Int      @default(0) @map("team_a_fouls")
  teamBFouls    Int      @default(0) @map("team_b_fouls")
  teamATimeouts Int      @default(0) @map("team_a_timeouts")
  teamBTimeouts Int      @default(0) @map("team_b_timeouts")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, quarter])
  @@index([matchId])
  @@map("basketball_quarters")
}
