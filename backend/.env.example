# ─── Server ───────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Public URL of the Next.js frontend (used for OAuth redirects + CORS)
FRONTEND_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────
# Matches docker-compose.yml credentials
DATABASE_URL=postgres://fieldcast:fieldcast@localhost:5432/fieldcast

# ─── Auth (JWT + Google OAuth) ────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be:  http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
# Comma-separated emails that are granted the "admin" role on login
ADMIN_EMAILS=you@example.com
ADMIN_EMAIL=admin@fieldcast.local
ADMIN_PASSWORD=change-this-admin-password
ADMIN_NAME=FieldCast Admin
# Session secret for the OAuth handshake cookie
SESSION_SECRET=another-long-random-string

# ─── Streaming (SRS + ffmpeg camera switcher) ─────────────────────────────
# When true, the camera switcher does NOT spawn ffmpeg — it just emits events.
# Use this to run/demo the app without SRS running.
SIMULATE_STREAM=true
# Host that phones push RTMP to and that ffmpeg targets. For LAN/port-forward
# use the machine's LAN IP or a tunnel host (e.g. an ngrok TCP address).
RTMP_HOST=localhost
RTMP_PORT=1935
SRT_PORT=10080
# Base URL the frontend uses to fetch LL-HLS playlists from SRS.
SRS_HLS_BASE=http://localhost:8080
# SRS HTTP API (stream health)
SRS_API_BASE=http://localhost:1985
# Path to the ffmpeg binary (must be on PATH or an absolute path)
FFMPEG_PATH=ffmpeg
